# Copie para backend.hcl e ajuste o bucket (nomes de bucket são globais).
# Uso: terraform init -backend-config=backend.hcl
bucket         = "oficina-terraform-state-<SEU-SUFIXO>"
key            = "oficina-infra-k8s/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "oficina-terraform-lock"
encrypt        = true
